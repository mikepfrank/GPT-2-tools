# This is a site-block example, NOT a replacement for the active Caddyfile.
# Replace the domain and merge this block into the existing proxy configuration
# only after local tests, a memory plan, and domain/DNS setup are complete.
gpt2.example.com {
    encode gzip
    reverse_proxy 127.0.0.1:8899 {
        # The backend validates Origin against its explicitly configured origin.
        # Forward the requested host, and overwrite the one trusted client-IP
        # header. Do not accept a visitor's forwarded identity.
        header_up Host {http.request.hostport}
        header_up X-Real-IP {http.request.remote.host}
        header_up -X-Forwarded-For
        header_up -Forwarded
    }
}
