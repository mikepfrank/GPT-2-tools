# Install as /etc/gpt2-public.env, owned by root and readable by root only.
# The service reads this file before switching to User=gpt-2.
# Set this to the EXACT browser origin, including scheme and a non-default port.
# For SSH-tunnel testing: http://localhost:8899
GPT2_PUBLIC_ORIGIN=http://localhost:8899
GPT2_THREADS=1
GPT2_MAX_REPLY_TOKENS=256
# This protects the shared host before the 6 GiB checkpoint is loaded.
# The inspected 8 GB host has insufficient available RAM. Keep this guard intact
# until its memory plan is resolved; swap does not count toward MemAvailable.
GPT2_MIN_AVAILABLE_MEMORY_GIB=8
HF_HOME=/home/gpt-2/.cache/gpt2-public/huggingface
HF_HUB_OFFLINE=1
TRANSFORMERS_OFFLINE=1
TOKENIZERS_PARALLELISM=false
PYTHONDONTWRITEBYTECODE=1
OMP_NUM_THREADS=1
MKL_NUM_THREADS=1
